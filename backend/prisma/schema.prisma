generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
}

model User {
  id             String                @id @default(cuid())
  email          String                @unique
  passwordHash   String?
  name           String
  avatarUrl      String?
  isEmailVerified Boolean              @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  memberships    ProjectMembership[]
  accounts       UserAccount[]
  refreshTokens  RefreshToken[]
}

model ProjectMembership {
  id         String      @id @default(cuid())
  userId     String
  projectId  String
  role       ProjectRole @default(MEMBER)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId, role])
}

model UserAccount {
  id                 String       @id @default(cuid())
  userId             String
  provider           AuthProvider
  providerAccountId  String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Project {
  id                String             @id @default(cuid())
  name              String
  apiKey            String             @unique
  createdAt         DateTime           @default(now())
  memberships       ProjectMembership[]
  alertEvents       AlertEvent[]
  alertRules        AlertRule[]
  anomalies         Anomaly[]
  endpointBaselines EndpointBaseline[]
  metrics           ApiMetric[]
  webhooks          Webhook[]
}

model ApiMetric {
  id         String   @id @default(cuid())
  endpoint   String
  method     String?
  latency    Int
  requests   Int
  statusCode Int
  requestId  String?
  responseSize Int?
  userAgent  String?
  environment String?
  metadata   Json?
  createdAt  DateTime @default(now())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])

  @@index([projectId, createdAt])
  @@index([projectId, endpoint, createdAt])
  @@index([projectId, statusCode, createdAt])
}

model AlertRule {
  id        String       @id @default(cuid())
  projectId String
  name      String
  metric    String
  threshold Float
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())
  severity  String       @default("MEDIUM")

  events    AlertEvent[]

  project   Project      @relation(fields: [projectId], references: [id])
}

model AlertEvent {
  id                   String    @id @default(cuid())
  projectId            String
  ruleId               String
  value                Float

  triggeredAt          DateTime  @default(now())

  lastNotificationAt   DateTime  @default(now())

  acknowledged         Boolean   @default(false)
  acknowledgedAt       DateTime?
  resolved             Boolean   @default(false)
  resolvedAt           DateTime?

  project Project   @relation(fields: [projectId], references: [id])
  rule    AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
}

model Webhook {
  id        String   @id @default(cuid())
  projectId String
  url       String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
}

model Anomaly {
  id         String    @id @default(cuid())
  projectId  String
  type       String
  endpoint   String
  value      Float
  threshold  Float
  severity   String    @default("WARNING")
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  detectedAt DateTime  @default(now())
  project    Project   @relation(fields: [projectId], references: [id])
}

model EndpointBaseline {
  id           String   @id @default(cuid())
  projectId    String
  endpoint     String
  avgLatency   Float
  stdDevLatency Float
  avgErrorRate Float
  avgRequests  Float
  sampleCount  Int
  calculatedAt DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id])

  @@unique([projectId, endpoint])
}